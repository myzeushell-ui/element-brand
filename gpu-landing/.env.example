# ── Обязательно перед production ────────────────────────────────
# Публичный адрес лендинга. Используется для canonical, OG, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://elementkb.ru

# ── Приём заявок ────────────────────────────────────────────────
# Куда пересылать заявки (CRM / Telegram-бот / Google Apps Script / n8n и т.п.).
# Если не задать — заявка примется, но никуда не уйдёт (только лог факта обращения).
LEAD_WEBHOOK_URL=

# ── Аналитика (опционально) ─────────────────────────────────────
# Без ID счётчики не подключаются, сайт работает без ошибок.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
